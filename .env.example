# ==============================================================================
# MedQuiz - Example Environment Variables (.env.example)
# Copy this file to .env and fill in your values
# ==============================================================================

# MongoDB Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/medquiz?retryWrites=true&w=majority

# Target MongoDB Database Name
MONGODB_DB=medquiz

# JWT Token Secret
JWT_SECRET=your_jwt_secret_key_here

# Admin Portal Credentials
ADMIN_EMAIL=admin@medquiz.fr
ADMIN_PASSWORD=admin2026
ADMIN_SECURITY_KEY=MED-FACULTY-2026

# Internal API Route URL
NEXT_PUBLIC_API_URL=/api
